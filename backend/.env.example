# ---- Django core
SECRET_KEY=change-me-in-dev
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (omit for zero-dependency SQLite dev mode)
# DATABASE_URL=postgres://fashionxp:fashionxp@localhost:5432/fashionxp

# ---- Cache / queues (omit to use in-process fallbacks)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# ---- AI provider: mock | openai-compatible (mock = no key needed)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# ---- Media backend: local | s3
MEDIA_BACKEND=local
MAX_UPLOAD_MB=10
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Auth providers
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
SMS_PROVIDER=console

# ---- Push notifications: console | fcm (FCM needs a server key)
PUSH_PROVIDER=console
FCM_SERVER_KEY=

# ---- Payments: mock | razorpay (mock confirms instantly in dev)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- CORS (mobile dev usually doesn't need this; web clients do)
CORS_ALLOWED_ORIGINS=

# ---- Throttles
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_AI=30/min
